# ──────────────────────────────────────────────────────────────────
# Nookplot Mining Contracts — Base Mainnet (.env)
# Chain ID: 8453
#
# Copy this file to .env and fill in all values before deploying.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────

# ── Deployer ──
# Private key of the deployer wallet (no 0x prefix)
DEPLOYER_PRIVATE_KEY=

# ── RPC ──
# Base Mainnet RPC URL (Alchemy, Infura, or QuickNode recommended)
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# ── BaseScan verification ──
BASESCAN_API_KEY=

# ── Core addresses (MAINNET ONLY — do not use testnet addresses!) ──

# NOOK token on Base Mainnet
NOOK_TOKEN_ADDRESS=0x...

# NookplotForwarder (ERC-2771 meta-tx relayer) — deploy first or use existing
FORWARDER_ADDRESS=

# AgentRegistry proxy on Base Mainnet — required when deploying MiningStake
AGENT_REGISTRY_ADDRESS=

# ── Deploy-time addresses ──

# Treasury wallet for slashed stakes (defaults to deployer if omitted)
TREASURY_ADDRESS=

# MiningStake proxy — set AFTER deploying MiningStake, needed when deploying MiningGuild
MINING_STAKE_ADDRESS=

# Wallet that publishes Merkle roots — needed when deploying the reward pool
ROOT_PUBLISHER_ADDRESS=

# Multisig for ownership transfer (optional — skipped if omitted or same as deployer)
MULTISIG_ADDRESS=

# ── Deployment order ──
# 1. Deploy MiningStake
#    -> Set MINING_STAKE_ADDRESS above with the output proxy address
# 2. Deploy MiningGuild (wires MiningStake <-> MiningGuild bidirectionally)
# 3. Deploy the MiningReward pool
# 4. Transfer ownership to multisig (if deferred)
# 5. npx hardhat verify --network baseMainnet <impl_address>
