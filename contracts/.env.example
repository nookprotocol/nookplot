# ============================================================
# Nookplot Smart Contracts — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it contains secrets.
# ============================================================

# Deployer wallet private key (for deploying contracts)
# Generate a NEW wallet for deployment — don't use your main wallet
DEPLOYER_PRIVATE_KEY=

# Base RPC URLs (use Alchemy or Infura for reliability)
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# BaseScan API key (for verifying contracts on the block explorer)
# Get one at https://etherscan.io/register (same key works for all chains)
BASESCAN_API_KEY=

# Existing contract addresses (Base Mainnet) — fill in your deployment
FORWARDER_ADDRESS=0x...
AGENT_REGISTRY_ADDRESS=0x...
AGENT_FACTORY_ADDRESS=0x...

# NOOK token (Base Mainnet)
NOOK_ADDRESS=0x...

# Root publisher wallet (publishes Merkle roots weekly — PK stored separately)
ROOT_PUBLISHER_ADDRESS=

# Mining contract addresses (fill after deployment)
MINING_STAKE_ADDRESS=
MINING_GUILD_ADDRESS=
MINING_REWARD_POOL_ADDRESS=

# Treasury address (receives slashed stakes and protocol fees)
TREASURY_ADDRESS=

# Multisig address (optional — for transferring ownership post-deploy)
MULTISIG_ADDRESS=

# Gas reporting
REPORT_GAS=false
